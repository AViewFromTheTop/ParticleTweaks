{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Tweaks and improves particles.",
  "authors": [
    "Lunade/AViewFromTheTop"
  ],
  "contact": {
    "homepage": "${mod_url}",
    "sources": "${source_url}",
    "issues": "${issues_url}"
  },
  "license": "${mod_license}",
  "icon": "assets/particletweaks/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.lunade.particletweaks.ParticleTweaksFabricClient"
    ],
    "modmenu": [
      "net.lunade.particletweaks.config.gui.ModMenuIntegration"
    ]
  },
  "mixins": [
    "particletweaks.movement.mixins.json",
    "particletweaks.scale.mixins.json",
    "particletweaks.trailer.mixins.json"
  ],
  "accessWidener": "particletweaks.classtweaker",
  "depends": {
    "frozenlib": "${frozenlib_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=25"
  },
  "suggests": {
    "cloth-config": "*",
    "modmenu": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "X": "https://x.com/FB_Oasis",
        "Bluesky": "https://bsky.app/profile/frozenblock.bsky.social",
        "modmenu.discord": "https://discord.gg/frozenblock",
        "modmenu.modrinth": "https://modrinth.com/organization/frozenblock",
        "modmenu.youtube": "https://www.youtube.com/@frozenblockmoddingoasismod",
        "modmenu.kofi": "https://ko-fi.com/frozenblock"
      }
    }
  }
}
